# PacePilot — copy to `.env` at the monorepo root.
# Root scripts (`pnpm dev`, `pnpm db:*`, etc.) load this file and pass it through to apps/packages.
# Never commit real secrets.

# --- Database (Neon pooled connection recommended for serverless) ---
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Apps ---
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Auth (Better Auth — phase 0.2) ---
# openssl rand -base64 32  (must be ≥32 characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Strava (phase 0.3) ---
# Create an app at https://www.strava.com/settings/api
# Authorization Callback Domain: localhost (local) or your deploy host
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# --- Token encryption at rest (phase 0.3) ---
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Background jobs (Inngest — optional / deferred) ---
# Phase 0 Strava sync runs in Next.js (apps/web). Inngest not required for founder dogfood.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- AI (later phases) ---
OPENAI_API_KEY=
