# PacePilot — copy to `.env.local` (apps) / `.env` (root) as needed.
# Never commit real secrets.

# --- Database (Supabase pooler or Neon pooled recommended for serverless) ---
DATABASE_URL=postgresql://user:password@host:5432/pacepilot?sslmode=require

# --- Apps ---
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Auth (Better Auth — phase 0.2) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Strava (phase 0.3) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# --- Token encryption at rest (phase 0.3) ---
TOKEN_ENCRYPTION_KEY=

# --- Background jobs (Inngest scaffold) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- AI (later phases) ---
OPENAI_API_KEY=
