{
  "name": "pacepilot",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "dotenv -e .env -- turbo build",
    "dev": "dotenv -e .env -- turbo dev",
    "lint": "turbo lint",
    "format": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "dotenv -e .env -- turbo test",
    "test:e2e": "dotenv -e .env -- pnpm --filter @pacepilot/e2e test",
    "db:generate": "dotenv -e .env -- pnpm --filter @pacepilot/db db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @pacepilot/db db:migrate",
    "db:push": "dotenv -e .env -- pnpm --filter @pacepilot/db db:push",
    "db:studio": "dotenv -e .env -- pnpm --filter @pacepilot/db db:studio",
    "db:seed": "dotenv -e .env -- pnpm --filter @pacepilot/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@workspace/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  }
}
